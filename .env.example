# Optional. The easiest way to connect is the in-app Setup page (http://localhost:3000/setup).
# Anything set here overrides what was entered in the app. Copy to .env.local to use.

# --- Muse Wonder (required) ---------------------------------------------------
# Meta Model API key: dev.meta.ai -> API keys
MODEL_API_KEY=

# --- Max (where leads come from) ----------------------------------------------
# Max API key and the business whose leads SignalPilot works on
MAX_API_KEY=
MAX_BUSINESS_ID=
# Only if you use Max webhooks instead of pulling (same value as --secret in Max)
MAX_WEBHOOK_SECRET=

# --- Overloop (how emails are sent) --------------------------------------------
# Overloop -> Settings -> API (Growth plan or higher)
OVERLOOP_API_KEY=
# The campaign that uses the SignalPilot custom fields (see README)
OVERLOOP_CAMPAIGN_ID=

# --- Safety ---------------------------------------------------------------------
# Leave empty to control sending from the Setup page. 0 = force off, 1 = force on.
SP_SENDING_ENABLED=
# Password for the whole UI (any username). Set this before exposing the app via a tunnel.
APP_PASSWORD=

# --- Advanced -------------------------------------------------------------------
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-wonder-1.0
# 0 = no background jobs (use the "Run now" buttons instead)
SP_JOBS_ENABLED=1
